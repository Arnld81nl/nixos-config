# Secrets configuration - COPY to secrets.nix and fill in your values
# This file is gitignored - your actual secrets.nix will not be committed
{
  # Git user email
  gitEmail = "your-email@example.com";

  # 1Password configuration
  onePassword = {
    # Your 1Password account identifier
    account = "my";

    # Vault/item paths for app-backup
    ageKey = "op://VAULT/age-key/private-key";
    sshKey = "op://VAULT/ssh-key/private key";
  };

  appBackup = {
    repoUrl = "git@github.com:YOUR_USER/private-settings.git";
    ageRecipient = "age1...your-public-key...";
  };

  eduroam = {
    identity = "user@example.edu";
    anonymousIdentity = "anonymous@example.edu";
    password = "placeholder";

    # Optional. PEM of an extra RADIUS CA the eduroam profile must trust on top
    # of the public bundle, for sites running a private RADIUS CA. Omit the
    # attribute entirely when the RADIUS cert chains to a public CA.
    # caCert = "";
  };

  # Private SSH hosts. Keep real hostnames, IPs, users, and key paths only in
  # gitignored secrets.nix.
  ssh.matchBlocks = {
    # "example-host" = {
    #   hostname = "192.0.2.10";
    #   user = "user";
    #   identityFile = "~/.ssh/example_key";
    # };
  };

  # VPN Configuration (also stored in ~/.config/vpn/config at runtime)
  vpn = {
    vpn1 = {
      name = "VPN 1";  # Display name for status bar
      host = "0.0.0.0:10443";
      opItem = "Vault/VPN-Item";
      cert = "";
    };
    vpn2 = {
      name = "VPN 2";
      # IPsec (FortiGate dial-up). The 1Password item must have `username`,
      # `password`, and `psk` fields. Add an optional `local-id` field if the
      # FortiGate dial-up matches on a peer-id different from the username.
      # Set ikeVersion = "1" for aggressive + XAuth, "2" for IKEv2 + EAP.
      type = "ipsec";
      server = "vpn.example.com";
      ikeVersion = "1";
      opItem = "Vault/VPN-Item";
      opAccount = "my";
    };
    vpn3 = {
      name = "VPN 3";
      host = "0.0.0.0:443";
      opItem = "Vault/VPN-Item";
      cert = "";
      subnet = "0.0.0";  # VPN tunnel subnet for status detection
      # OpenVPN with client certificates
      type = "openvpn";
      caCert = "";
      clientCert = "";
      clientKey = "";  # Keep private key material only in gitignored secrets.nix
    };
    vpn4 = {
      name = "VPN 4";
      wgConfig = "";  # WireGuard config
    };
  };
}
